<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<PackageId>SkyWebFramework.DependencyInjection</PackageId>
		<Version>1.0.0</Version>
		<Authors>Surya Pratap Singh</Authors>
		<Company>SkyWebFramework</Company>
		<Product>EasyDI - Enterprise Dependency Injection and Assembly Scanning Engine</Product>
		<Description>High-performance convention and attribute-driven Dependency Injection framework for .NET with automatic assembly scanning, custom attributes ([Scoped], [Transient], [Singleton], [RegisterAs], [KeyedService]), modular architecture (IEasyServiceModule), decorator &amp; interceptor patterns, lazy resolution, and comprehensive diagnostics (captive &amp; circular dependency detection).</Description>
		<PackageTags>dependency-injection;di;ioc;service-scanning;aspnetcore;autofac;scrutor;skywebframework;dotnet;csharp;enterprise;decorators;captive-dependency;keyed-services;easy-di</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Skyrunner-Dev-ops/SkyWebFramework.DependencyInjection</RepositoryUrl>
		<PackageProjectUrl>https://skywebframework.com/docs/dependencyinjection</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>SkyWebFramework.png</PackageIcon>
		<Copyright>Copyright (c) 2026 Surya Pratap Singh</Copyright>

		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>false</IncludeSymbols>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" Condition="'$(TargetFramework)' == 'net8.0'" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" Condition="'$(TargetFramework)' == 'net9.0'" />
		<Compile Remove="tests\**" />
		<EmbeddedResource Remove="tests\**" />
		<None Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="SkyWebFramework.png" Pack="true" PackagePath="\" Condition="Exists('SkyWebFramework.png')" />
		<None Include="LICENSE.txt" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>
</Project>
